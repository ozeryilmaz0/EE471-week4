{
  "info": {
    "name": "Week 7 - Fashion-MNIST (Cog)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start the containers with docker compose -f docker-compose.fashion.yml up -d, then Send each request."
  },
  "item": [
    {
      "name": "fashion-baseline health-check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Model is READY\", () => pm.expect(pm.response.json().status).to.eql(\"READY\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5010/health-check",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5010",
          "path": [
            "health-check"
          ]
        }
      }
    },
    {
      "name": "fashion-optimized health-check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Model is READY\", () => pm.expect(pm.response.json().status).to.eql(\"READY\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5011/health-check",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5011",
          "path": [
            "health-check"
          ]
        }
      }
    },
    {
      "name": "fashion-baseline predict",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Prediction succeeded\", () => pm.expect(body.status).to.eql(\"succeeded\"));",
              "pm.test(\"Has predicted_class and top3\", () => {",
              "    pm.expect(body.output).to.have.property(\"predicted_class\");",
              "    pm.expect(Object.keys(body.output.top3)).to.have.lengthOf(3);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"image\": \"data:image/png;base64,\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5010/predictions",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5010",
          "path": [
            "predictions"
          ]
        },
        "description": "Body contains sample_images/09_ankle_boot_1.png as a base64 data URI."
      }
    },
    {
      "name": "fashion-optimized predict",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Prediction succeeded\", () => pm.expect(body.status).to.eql(\"succeeded\"));",
              "pm.test(\"Has predicted_class and top3\", () => {",
              "    pm.expect(body.output).to.have.property(\"predicted_class\");",
              "    pm.expect(Object.keys(body.output.top3)).to.have.lengthOf(3);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"image\": \"data:image/png;base64,\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5011/predictions",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5011",
          "path": [
            "predictions"
          ]
        },
        "description": "Body contains sample_images/09_ankle_boot_1.png as a base64 data URI."
      }
    }
  ]
}